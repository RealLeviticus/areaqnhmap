// Cloudflare Worker: airspace proxy
export default {
  async fetch(_req) {
    const upstream = 'https://raw.githubusercontent.com/vatSys/australia-dataset/master/Airspace.xml';
    try {
      const r = await fetch(upstream, { redirect: 'follow' });
      if (!r.ok) return new Response('Upstream error', { status: r.status });
      const body = await r.text();
      return new Response(body, {
        status: 200,
        headers: {
          'Content-Type': 'application/xml; charset=utf-8',
          'Access-Control-Allow-Origin': '*',
          'Cache-Control': 'public, max-age=86400' // 1-day cache; adjust as needed
        }
      });
    } catch (e) {
      return new Response('Fetch failed', { status: 502 });
    }
  },
};