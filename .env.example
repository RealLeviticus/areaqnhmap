# Every value here has a working default; this file documents the knobs rather
# than being required. Copy to .env on the VPS only if you need to change one.

# PORT=8080
# DATA_DIR=/data

# How often to re-check BOM. Area QNH is issued every three hours, so the
# default of five minutes is already far more often than the data changes.
# QNH_REFRESH_MS=300000

# Keep serving the last good forecast for this long if BOM is unreachable.
# QNH_STALE_MS=21600000

# Set to 0 to run the site without generating chart images.
# SCREENSHOTS_ENABLED=1
# SCREENSHOT_CHECK_MS=600000
