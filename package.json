{
  "name": "areaqnhmap",
  "version": "2.0.0",
  "private": true,
  "description": "Map of Australian Area QNH forecasts, derived from the Bureau of Meteorology's public Area QNH page.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "shoot": "node src/cli-screenshots.js",
    "build:basemap": "node scripts/build-basemap.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "maplibre-gl": "^5.24.0",
    "puppeteer-core": "^23.11.1"
  }
}
